#!/usr/bin/env bash

text=${1:-$(xclip -o -selection primary 2>/dev/null || wl-paste 2>/dev/null)}

[[ -z "$text" ]] && {
    notify-send -t 3000 "No text selected"
    exit 0
}

translation=$(trans -brief -e google :en "$text" 2>/dev/null)

[[ -z "$translation" ]] && {
    notify-send -t 3000 "Translation failed"
    exit 1
}

notify-send -t 60000 "Translation" "$translation"
